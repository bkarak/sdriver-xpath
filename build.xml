<project name="xpath-injection" default="release">
  <description>
  SDriver/XPath
  Vassilios Karakoidas (bkarak@aueb.gr) - http://gaijin.dmst.aueb.gr/~bkarak/
        
  Software Engineering and Security Research Group (ISTLab/SENSE) - http://istlab.dmst.aueb.gr/ 
  </description>
	
  <!-- Property Declaration -->
  <property name="build" location="${basedir}/build"/>
  <property name="src" location="${basedir}/src"/>
  <property name="lib" location="${basedir}/lib"/>
    
  <path id="libclasspath">
    <pathelement location="lib/fast-md5.jar"/>
  </path>
  <!-- Compile and produce jar -->
  <target name="release">
    <echo>Compiling SDriver/XPath ...</echo>
    <javac srcdir="${src}" destdir="${build}" source="1.6" target="1.6"
	   debug="off" optimize="on">
     <classpath refid="libclasspath"/>
   </javac>
   <pathconvert property="mf.classpath" pathsep=" ">
     <path refid="libclasspath" />
   </pathconvert>
   <jar basedir="${build}" destfile="${basedir}/sdriverxpath.jar">
     <fileset dir="${build}"/>
     <fileset dir="${lib}"/>
     <manifest>
       <attribute name="Main-Class" value="org.sdriver.xpath.test.Main"/>
       <attribute name="Class-Path" value="${mf.classpath}"/>
     </manifest>
   </jar>
  </target>
	
	<target name="clean">
		<echo>Cleaning the mess ...</echo>
		<delete file="${basedir}/sdriverxpath.jar" />
		<delete>
			<fileset dir="${build}" includes="**/*"/>
		</delete>
	</target>
</project>
